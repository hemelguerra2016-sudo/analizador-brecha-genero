digraph G { rankdir=TB; bgcolor=white; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=plaintext]; edge [fontname="Helvetica", fontsize=10];
label=<<B>Diagrama de clases UML</B>>; labelloc=t; fontsize=16;
Empleado [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fdf1dc"><B>Empleado</B><BR/><I>modelo</I></TD></TR><TR><TD ALIGN="LEFT">- codigo: String<BR ALIGN="LEFT"/>- nombre: String<BR ALIGN="LEFT"/>- sexo: char<BR ALIGN="LEFT"/>- cargo: String<BR ALIGN="LEFT"/>- area: String<BR ALIGN="LEFT"/>- nivel: int<BR ALIGN="LEFT"/>- salario: double<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ getCodigo(): String<BR ALIGN="LEFT"/>+ getSalario(): double<BR ALIGN="LEFT"/>+ setSalario(s: double): void<BR ALIGN="LEFT"/>+ toString(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
NodoDoble [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e3eefc"><B>NodoDoble</B></TD></TR><TR><TD ALIGN="LEFT">- dato: Empleado<BR ALIGN="LEFT"/>- anterior: NodoDoble<BR ALIGN="LEFT"/>- siguiente: NodoDoble<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ getters / setters<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Lista [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e3eefc"><B>ListaDobleEmpleados</B></TD></TR><TR><TD ALIGN="LEFT">- cabeza: NodoDoble<BR ALIGN="LEFT"/>- cola: NodoDoble<BR ALIGN="LEFT"/>- tamanio: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ insertarAlFinal(e): void<BR ALIGN="LEFT"/>+ insertarOrdenadoPorSalario(e): void<BR ALIGN="LEFT"/>+ buscarPorCodigo(c): Empleado<BR ALIGN="LEFT"/>+ modificarSalario(c, s): boolean<BR ALIGN="LEFT"/>+ eliminarPorCodigo(c): boolean<BR ALIGN="LEFT"/>+ recorrerAdelante(): void<BR ALIGN="LEFT"/>+ recorrerAtras(): void<BR ALIGN="LEFT"/>+ estaVacia(): boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
NodoAVL [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e4f4e6"><B>NodoAVL</B></TD></TR><TR><TD ALIGN="LEFT">- dato: Empleado<BR ALIGN="LEFT"/>- altura: int<BR ALIGN="LEFT"/>- izquierdo: NodoAVL<BR ALIGN="LEFT"/>- derecho: NodoAVL<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ getters / setters<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AVL [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e4f4e6"><B>ArbolAVL</B></TD></TR><TR><TD ALIGN="LEFT">+ POR_CODIGO: int = 1<BR ALIGN="LEFT"/>+ POR_SALARIO: int = 2<BR ALIGN="LEFT"/>- raiz: NodoAVL<BR ALIGN="LEFT"/>- criterio: int<BR ALIGN="LEFT"/>- tamanio: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ insertar(e): boolean<BR ALIGN="LEFT"/>+ buscarPorCodigo(c): Empleado<BR ALIGN="LEFT"/>+ inorden(): void<BR ALIGN="LEFT"/>+ consultarRangoSalarial(min, max): ListaDobleEmpleados<BR ALIGN="LEFT"/>- rotarDerecha(n): NodoAVL<BR ALIGN="LEFT"/>- rotarIzquierda(n): NodoAVL<BR ALIGN="LEFT"/>+ getAltura(): int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Analizador [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#f0e6f7"><B>AnalizadorEquidad</B></TD></TR><TR><TD ALIGN="LEFT">+ promedioSalarial(l, sexo, nivel): double<BR ALIGN="LEFT"/>+ brechaSalarial(l, nivel): double<BR ALIGN="LEFT"/>+ porcentajeMujeres(l, nivel): double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Lista -> NodoDoble [arrowhead=none, arrowtail=diamond, dir=back, label=" 1..* "];
AVL -> NodoAVL [arrowhead=none, arrowtail=diamond, dir=back, label=" 1..* "];
NodoDoble -> Empleado [label=" dato "]; NodoAVL -> Empleado [label=" dato "];
NodoDoble -> NodoDoble [label="anterior / siguiente"]; NodoAVL -> NodoAVL [label="izq / der"];
AVL -> Lista [style=dashed, label=" devuelve "]; Analizador -> Lista [style=dashed, label=" usa "];
{rank=same; Lista; AVL; Analizador}
}
